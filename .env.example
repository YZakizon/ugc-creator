DATABASE_URL=postgresql+psycopg://ugc:ugc@localhost:5432/ugc_creator
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=ugc-creator
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_PROMPT_TEMPLATE=
OPENAI_PROMPT_VERSION=ugc-v1
COMFYUI_BASE_URL=http://host.docker.internal:8188
COMFYUI_ALLOWED_HOSTS=host.docker.internal
RENDER_TIMEOUT_SECONDS=3600
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_MODEL=eleven_multilingual_v2

# Set to 1 only for deterministic local/test generation without paid providers.
UGC_FAKE_PROVIDERS=0

# Host-development URL used by the Next.js server. Compose overrides this.
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

TRAEFIK_ENABLE=true
TRAEFIK_ENVIRONMENT=dev
TRAEFIK_HOST=ugc.localhost
TRAEFIK_ENTRYPOINT=web

# Dedicated integration-test database (used by api/tests/test_postgres_integration.py)
TEST_DATABASE_URL=postgresql+psycopg://ugc_test:ugc_test@localhost:55432/ugc_creator_test
